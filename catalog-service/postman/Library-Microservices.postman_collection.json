            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Titre valide\",\n  \"author\": \"Auteur\",\n  \"category\": \"Tech\",\n  \"availableStock\": -1\n}" },
            "url": "{{catalogBaseUrl}}/books"
          }
        },
        {
          "name": "GET /books/99999 ❌ introuvable → 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
            "pm.test('Réponse erreur structurée', () => {",
