    {
      "name": "📚 Catalog — Books [direct :8081]",
      "item": [
        {
          "name": "POST /books ✅ crée livre (sauvegarde bookId)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Corps structuré', () => {",
            "  const d = pm.response.json();",
            "  pm.expect(d.id).to.be.a('number');",
            "  pm.expect(d.title).to.equal('Clean Code');",
            "  pm.expect(d.author).to.equal('Robert C. Martin');",
            "  pm.expect(d.availableStock).to.equal(5);",
            "  pm.expect(d.version).to.be.a('number');",
            "});",
            "pm.collectionVariables.set('bookId', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"category\": \"Software\",\n  \"availableStock\": 5\n}" },
            "url": "{{catalogBaseUrl}}/books"
          }
        },
        {
          "name": "GET /books (liste complète)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Tableau non vide', () => {",
            "  const d = pm.response.json();",
            "  pm.expect(d).to.be.an('array').with.length.at.least(1);",
            "});",
            "pm.test('Chaque livre a id+title+availableStock', () => {",
            "  pm.response.json().forEach(b => {",
            "    pm.expect(b.id).to.be.a('number');",
            "    pm.expect(b.title).to.be.a('string');",
            "    pm.expect(b.availableStock).to.be.a('number');",
            "  });",
            "});"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{catalogBaseUrl}}/books" }
        },
        {
          "name": "GET /books/paginated",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Structure Page Spring', () => {",
            "  const d = pm.response.json();",
            "  pm.expect(d.content).to.be.an('array');",
            "  pm.expect(d.totalElements).to.be.a('number');",
            "  pm.expect(d.totalPages).to.be.a('number');",
            "  pm.expect(d.size).to.equal(10);",
            "  pm.expect(d.number).to.equal(0);",
            "});"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{catalogBaseUrl}}/books/paginated?page=0&size=10&sort=title,asc",
              "host": ["{{catalogBaseUrl}}"], "path": ["books","paginated"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "title,asc" }
              ]
            }
          }
        },
        {
          "name": "GET /books/{bookId}",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('ID correspond', () => pm.expect(pm.response.json().id).to.equal(Number(pm.collectionVariables.get('bookId'))));",
            "pm.test('Stock est un entier ≥ 0', () => pm.expect(pm.response.json().availableStock).to.be.at.least(0));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{catalogBaseUrl}}/books/{{bookId}}" }
        },
        {
          "name": "PUT /books/{bookId} (mise à jour)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Titre mis à jour', () => pm.expect(pm.response.json().title).to.equal('Clean Code (2e éd.)'));",
            "pm.test('Stock mis à jour', () => pm.expect(pm.response.json().availableStock).to.equal(4));",
            "pm.test('Version incrémentée', () => pm.expect(pm.response.json().version).to.be.at.least(1));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code (2e éd.)\",\n  \"author\": \"Robert C. Martin\",\n  \"category\": \"Software\",\n  \"availableStock\": 4\n}" },
            "url": "{{catalogBaseUrl}}/books/{{bookId}}"
          }
        },
        {
