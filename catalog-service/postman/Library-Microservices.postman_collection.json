            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"author\": \"Auteur\",\n  \"category\": \"Tech\",\n  \"availableStock\": 1\n}" },
            "url": "{{catalogBaseUrl}}/books"
          }
        },
        {
          "name": "POST /books ❌ stock négatif → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
